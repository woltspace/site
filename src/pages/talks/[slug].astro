---
import Page from '../../layouts/Page.astro';
import { talks, talkDay } from '../../lib/talks';
export function getStaticPaths() { return talks.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props;
---
<Page title={t.title} description={t.summary} path="/talks">
  <p class="back"><a href="/">woltspace</a> / <a href="/talks">talks</a></p>
  <p class="stamp">{talkDay(t.date)}{t.event && ` · ${t.event}`}{t.upcoming && <span class="draft"> · upcoming</span>}</p>
  <h1>{t.title}</h1>
  <p class="lead">{t.summary}</p>

  <h2 class="talk-h">Recording{t.length && <span class="talk-len"> · {t.length}</span>}</h2>
  {t.video
    ? <div class="talk-video"><video src={t.video} controls playsinline preload="metadata"></video></div>
    : t.youtube
    ? <div class="talk-video"><iframe src={`https://www.youtube-nocookie.com/embed/${t.youtube}`} title={`${t.title} (recording)`} loading="lazy" allowfullscreen></iframe></div>
    : <p class="talk-soon">Recording coming.</p>}
  {(t.slidesUrl || t.blog) && (
    <p class="talk-links">
      {t.blog && <a class="talk-btn" href={t.blog}>Read the blog post →</a>}
      {t.slidesUrl && <a class="talk-btn" href={t.slidesUrl}>Open the slides →</a>}
    </p>
  )}

  {t.slideImages && (
    <>
      <h2 class="talk-h">Slides <button class="talk-btn talk-present" type="button">Present ▶</button></h2>
      <div class="talk-slides">
        {t.slideImages.files.map((f, i) => <a href={`/media/${t.slideImages!.folder}/${f}.png`} data-i={i}><img src={`/media/${t.slideImages!.folder}/${f}.png`} alt={f.replace(/^slide-\d+-/, '')} loading="lazy" /></a>)}
      </div>
      <div class="deck" hidden><img alt="" /><p class="deck-n"></p></div>
    </>
  )}

  {t.text && (
    <>
      <h2 class="talk-h">The text</h2>
      <div class="prose" set:html={t.text} />
    </>
  )}
</Page>
<script>
  // Present the slide images: full screen, ← → / space / click (left half back, right half forward) / swipe, Esc closes.
  const deck = document.querySelector<HTMLElement>('.deck');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.talk-slides a')];
  if (deck && links.length) {
    const img = deck.querySelector('img')!, n = deck.querySelector('.deck-n')!;
    let at = 0;
    const show = (i: number) => { at = Math.max(0, Math.min(links.length - 1, i)); img.src = links[at].href; n.textContent = `${at + 1} / ${links.length}`; };
    const open = (i: number) => { show(i); deck.hidden = false; deck.requestFullscreen?.().catch(() => {}); };
    const close = () => { deck.hidden = true; if (document.fullscreenElement) document.exitFullscreen(); };
    document.querySelector('.talk-present')?.addEventListener('click', () => open(0));
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
    deck.addEventListener('click', (e) => show(at + (e.clientX < innerWidth / 2 ? -1 : 1)));
    document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) deck.hidden = true; });
    addEventListener('keydown', (e) => {
      if (deck.hidden) return;
      if (e.key === 'Escape') close();
      else if (['ArrowRight', 'ArrowDown', ' ', 'PageDown'].includes(e.key)) { e.preventDefault(); show(at + 1); }
      else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); show(at - 1); }
    });
    let x0 = 0;
    deck.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    deck.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1)); });
  }
</script>
<style>
  .talk-h { margin: 34px 0 12px; font-size: 20px; }
  .talk-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .talk-len { color: var(--soft); font-weight: 400; }
  .talk-btn { display: inline-block; padding: 10px 16px; border: 2px solid var(--accent); border-radius: 8px; color: var(--accent); font-weight: 700; text-decoration: none; }
  .talk-btn:hover { background: var(--accent); color: #fff; }
  .talk-slides { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .talk-slides img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); display: block; }
  .talk-video { position: relative; aspect-ratio: 16 / 9; }
  .talk-video video { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 10px; background: #000; }
  .talk-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 10px; }
  .talk-present { margin-left: 10px; padding: 4px 12px; font-size: 14px; vertical-align: middle; cursor: pointer; background: none; font-family: inherit; }
  .deck { position: fixed; inset: 0; z-index: 100; background: #000; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .deck[hidden] { display: none; }
  .deck img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .deck-n { position: absolute; bottom: 10px; right: 16px; margin: 0; color: #888; font: 13px ui-monospace, monospace; }
  .talk-soon { color: var(--soft); font-style: italic; }
</style>
