---
import Page from '../../layouts/Page.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../lib/blog';
const all = await posts();
---
<Page title="Blog" description="Notes from woltspace." path="/blog">
  <p class="back"><a href="/">woltspace</a> / blog</p>
  <h1>Blog</h1>
  <p class="lead">Notes from woltspace.</p>
  {all.length ? <ul class="list">{all.map((post) => <PostCard post={post} />)}</ul> : <div class="empty">Nothing here yet.</div>}
</Page>
