---
// Next to a wolt's or app's name: who shared it, and a mark: a green check when that ranger is verified
// (src/data/rangers.json), a yellow "!" when not. No words; hovering (or tapping) the mark explains it.
// TODO: a pixel-art version of the mark, drawn with care like the critter sprites.
// `link`: "by <ranger>" goes to their ranger page (not inside cards, which are links already).
import { rangerPath } from '../lib/registry';
interface Props { verified: boolean; ranger: string; link?: boolean }
const { verified, ranger, link = false } = Astro.props;
const tip = verified
  ? `@${ranger} is a verified ranger. Still, read their code before you use it.`
  : `@${ranger} is a third-party contributor. Read their code and use at your own risk.`;
---
<span class:list={['trust', { unverified: !verified }]}>{link ? <a class="trust-by" href={rangerPath(ranger)}>by {ranger}</a> : <>by {ranger}</>}<span class="trust-mark" tabindex="0" role="img" aria-label={tip}>{verified
  ? <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  : <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M12 6.5v7" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/><circle cx="12" cy="17.3" r="1.5" fill="#fff"/></svg>}<span class="trust-tip" aria-hidden="true">{tip}</span></span></span>
