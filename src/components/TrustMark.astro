---
// Next to a wolt's or app's name: who shared it, and whether that ranger is verified (src/data/rangers.json).
interface Props { verified: boolean; ranger: string }
const { verified, ranger } = Astro.props;
---
{verified ? <span class="trust">by {ranger} · ✓ verified</span> : <span class="trust unverified">⚠ unverified</span>}
