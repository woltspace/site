---
// The banner every third-party wolt and app carries.
interface Props { kind: 'wolt' | 'app'; ranger: string }
const { kind, ranger } = Astro.props;
---
<div class="warn">
  <strong>⚠️ Third party</strong>
  This {kind} is maintained by <b>@{ranger}</b>, not by Woltspace. It was reviewed to get listed here, but
  @{ranger} can change it at any time, and we can't control what changes.
  <p>Like anything you find online, use it at your own risk: read the source before you
    {kind === 'wolt' ? 'paste it into a chat or install it' : 'install it'}.</p>
</div>
