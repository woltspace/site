// Animates critters using canvas frame cycling.
// Walk = legs alternate (scene beavers, otter), Idle = subtle bob (raccoon, mockup critters)
(function(){
  var px=3;

  function makeSprite(frames, w, h, fps){
    var cv=document.createElement('canvas');
    cv.width=w; cv.height=h;
    cv.style.cssText='image-rendering:pixelated;display:block;width:'+w+'px;height:'+h+'px';
    var ctx=cv.getContext('2d');
    var fi=0;

    function draw(){
      ctx.clearRect(0,0,w,h);
      var f=frames[fi];
      for(var r=0;r<f.map.length;r++){
        var row=f.map[r];
        for(var c=0;c<row.length;c++){
          var ch=row[c];
          if(ch==='.'||ch===' ')continue;
          var col=f.pal[ch];
          if(!col)continue;
          ctx.fillStyle=col;
          ctx.fillRect(c*px,r*px,px,px);
        }
      }
      fi=(fi+1)%frames.length;
    }

    draw();
    setInterval(draw, 1000/fps);
    return cv;
