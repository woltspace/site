  var ottFrames=[{map:ottFull,pal:ottPal},{map:ottB,pal:ottPal}];

  // ── Apply to scene critters ──
  var sb=document.getElementById('sc-beaver1');
  if(sb){sb.innerHTML='';sb.appendChild(makeSprite(beavFrames,beavW,beavH,4));}
  var sr=document.getElementById('sc-raccoon1');
  if(sr){sr.innerHTML='';sr.appendChild(makeSprite(raccFrames,raccW,raccH,2));}
  var so=document.getElementById('sc-otter1');
  if(so){so.innerHTML='';so.appendChild(makeSprite(ottFrames,ottW,ottH,4));}

  // ── Apply to mockup critters ──
  var mb=document.getElementById('beaver-pixel');
  if(mb){mb.className='critter beaver-sprite';mb.innerHTML='';mb.appendChild(makeSprite(beavFrames,beavW,beavH,4));}
  var mr=document.getElementById('raccoon-pixel');
  if(mr){mr.className='critter raccoon-sprite';mr.innerHTML='';mr.appendChild(makeSprite(raccFrames,raccW,raccH,2));}
  var mo=document.getElementById('otter-pixel');
  if(mo){mo.className='critter otter-sprite';mo.innerHTML='';mo.appendChild(makeSprite(ottFrames,ottW,ottH,4));}
})();

</script>
