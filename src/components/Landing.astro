<script is:inline>
  // The headline's last word is typed like a terminal (jerpint's list). Server HTML says
  // "a lodge.", so readers without scripts and crawlers get that line. Text only, no HTML.
  document.querySelectorAll('.kw-type').forEach(function (kw) {
    var words = kw.dataset.words.split('|'), i = 0;
    var still = matchMedia('(prefers-reduced-motion: reduce)');
    var caret = kw.nextElementSibling;
    function next() {
      i = (i + 1) % words.length;
      if (still.matches) { kw.textContent = words[i]; return setTimeout(next, 2600); }
      caret.classList.add('busy');
      (function erase() {
        if (kw.textContent.length) { kw.textContent = kw.textContent.slice(0, -1); return setTimeout(erase, 35); }
        var n = 0;
        (function type() {
          kw.textContent = words[i].slice(0, ++n);
          if (n < words[i].length) return setTimeout(type, 75);
          caret.classList.remove('busy'); setTimeout(next, 2200);
        })();
      })();
    }
    setTimeout(next, 1300);
  });

function copyText(value, labelId){
  var label=document.getElementById(labelId);
  var button=label.closest('button');
  var originalLabel=label.textContent;
  var originalAria=button.getAttribute('aria-label');
  function onSuccess(){
    label.textContent='✓ Copied';
    button.setAttribute('aria-label','Copied');
    button.classList.add('copied');
    setTimeout(function(){label.textContent=originalLabel;button.setAttribute('aria-label',originalAria);button.classList.remove('copied')},2000);
  }
  function onFail(){
    var ta=document.createElement('textarea');
    ta.value=value;
    ta.style.cssText='position:fixed;top:0;left:0;opacity:0;pointer-events:none';
    document.body.appendChild(ta);
    ta.focus();ta.select();
    try{document.execCommand('copy');onSuccess();}catch(e){}
    document.body.removeChild(ta);
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(value).then(onSuccess,onFail);
  } else {
    onFail();
  }
}

(function setupInstallPicker(){
  var picker=document.querySelector('[data-install-picker]');
  if(!picker)return;
  Array.from(picker.querySelectorAll('[role="tablist"]')).forEach(function(tablist){
    var tabs=Array.from(tablist.children).filter(function(child){return child.getAttribute('role')==='tab'});

    function activate(tab, moveFocus){
      tabs.forEach(function(candidate){
        var selected=candidate===tab;
        candidate.setAttribute('aria-selected',String(selected));
        candidate.tabIndex=selected?0:-1;
        var panel=document.getElementById(candidate.getAttribute('aria-controls'));
        if(panel)panel.hidden=!selected;
      });
      if(moveFocus)tab.focus();
    }

    tabs.forEach(function(tab,index){
      tab.addEventListener('click',function(){activate(tab,false)});
      tab.addEventListener('keydown',function(event){
        var nextIndex;
        if(event.key==='ArrowLeft')nextIndex=(index+tabs.length-1)%tabs.length;
        else if(event.key==='ArrowRight')nextIndex=(index+1)%tabs.length;
        else if(event.key==='Home')nextIndex=0;
        else if(event.key==='End')nextIndex=tabs.length-1;
        else return;
        event.preventDefault();
        activate(tabs[nextIndex],true);
      });
    });
  });
})();

